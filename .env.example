# 前端与 Userscript 构建时使用。
VITE_DBKANG_BASE_URL=http://localhost:8000
VITE_DBKANG_TOOLBOX_URL=http://localhost:8000/toolbox
DBKANG_PUBLIC_BASE_URL=http://localhost:8000
DBKANG_VERSION=0.1.4

# FastAPI 使用；生产环境务必更换 SECRET_KEY 与管理员密码。
DBKANG_DATABASE_URL=sqlite:///./server/data/dbkang.sqlite3
DBKANG_SECRET_KEY=change-me-before-production
DBKANG_ADMIN_USERNAME=admin
DBKANG_ADMIN_PASSWORD=change-me
DBKANG_BOOTSTRAP_COURSE_IDS=
DBKANG_CORS_ORIGINS=http://localhost:5173,http://localhost:5174
